// ============================================================
// IMAT Prep Platform — Prisma Schema
// Day 3: Expanded schema with DailyQuestionLimit, Topic tags,
//        difficulty tracking, and performance-ready indexes.
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────

enum SubscriptionStatus {
  FREE
  MONTHLY
  YEARLY
  LIFETIME
}

enum Section {
  READING     // Reading Skills & General Knowledge
  LOGICAL     // Logical Reasoning & Problem Solving
  BIOLOGY
  CHEMISTRY
  PHYSICS
  MATHS
}

enum QuizMode {
  PRACTICE    // Untimed, see explanation after each question
  EXAM        // Timed, see results at the end
}

// How a purchase reached us. MANUAL is the only provider confirmed today:
// BINANCE / PAYONEER adapters land once those accounts exist and can be tested.
enum PurchaseProvider {
  MANUAL
  BINANCE
  PAYONEER
  CODE       // granted by redeeming an access code
}

enum PurchaseStatus {
  PENDING
  PAID
  REFUNDED
  CANCELLED
}

// ─────────────────────────────────────────
// USER
// ─────────────────────────────────────────

model User {
  id                 String             @id @default(cuid())
  name               String
  email              String             @unique
  password           String
  subscriptionStatus SubscriptionStatus @default(FREE)
  subscriptionEnd    DateTime?          // null = no active paid period (LIFETIME also null)
  stripeCustomerId   String?            @unique
  partnerCode        String?            // who introduced this student, captured at signup
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  // Relations
  attempts           Attempt[]
  sessions           Session[]
  dailyLimits        DailyQuestionLimit[]
  purchases          Purchase[]

  @@map("users")
}

// ─────────────────────────────────────────
// DAILY QUESTION LIMIT (free tier enforcement)
// Free users get 10 questions per calendar day.
// One row per user per date — reset automatically
// when a new day starts (just create a new row).
// ─────────────────────────────────────────

model DailyQuestionLimit {
  id            String   @id @default(cuid())
  userId        String
  date          DateTime @db.Date   // calendar date only, no time
  questionsUsed Int      @default(0) // how many questions answered today
  limitReached  Boolean  @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One record per user per day
  @@unique([userId, date])
  @@index([userId, date])
  @@map("daily_question_limits")
}

// ─────────────────────────────────────────
// ACCESS CODE
// A code is how money that arrived outside the app — a Binance payment, a
// Payoneer transfer, a WhatsApp deal, a partner's bulk classroom licence —
// turns into entitlement. One code can serve many seats.
// ─────────────────────────────────────────

model AccessCode {
  id             String             @id @default(cuid())
  code           String             @unique
  plan           SubscriptionStatus
  durationDays   Int?               // null = lifetime
  maxRedemptions Int                @default(1)
  redeemedCount  Int                @default(0)
  partnerCode    String?            // revenue share is attributed here
  note           String?
  revoked        Boolean            @default(false)
  expiresAt      DateTime?          // last day the code itself can be redeemed
  createdAt      DateTime           @default(now())

  purchases Purchase[]

  @@index([partnerCode])
  @@map("access_codes")
}

// ─────────────────────────────────────────
// PURCHASE  (the money ledger — append, don't edit)
// users.subscriptionStatus is the *effective* entitlement; this is the record
// of why. Every grant writes both in one transaction; a refund revokes both.
// ─────────────────────────────────────────

model Purchase {
  id           String           @id @default(cuid())
  userId       String?
  plan         SubscriptionStatus
  provider     PurchaseProvider @default(MANUAL)
  status       PurchaseStatus   @default(PENDING)
  amount       Decimal          @db.Decimal(10, 2)
  currency     String           @default("EUR")
  externalRef  String?          @unique // payment reference, or code if granted manually
  accessCodeId String?
  partnerCode  String?
  grantedAt    DateTime?
  expiresAt    DateTime?        // null = lifetime
  refundedAt   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  accessCode AccessCode? @relation(fields: [accessCodeId], references: [id])

  // Stops one code being redeemed twice by the same student.
  // Postgres permits unlimited NULLs in a unique index, so non-code purchases are unaffected.
  @@unique([accessCodeId, userId])
  @@index([userId, status])
  @@index([partnerCode])
  @@index([status, createdAt])
  @@map("purchases")
}

// ─────────────────────────────────────────
// PAPER
// ─────────────────────────────────────────

model Paper {
  id          String   @id @default(cuid())
  year        Int      @unique
  title       String
  pdfUrl      String
  isFree      Boolean  @default(true)
  totalMarks  Int      @default(60)  // IMAT: 60 questions
  durationMin Int      @default(100) // IMAT: 100 minutes
  createdAt   DateTime @default(now())

  // Relations
  questions Question[]
  sessions  Session[]

  @@index([year])
  @@map("papers")
}

// ─────────────────────────────────────────
// QUESTION
// ─────────────────────────────────────────

model Question {
  id            String  @id @default(cuid())
  paperId       String
  section       Section
  questionText  String  @db.Text
  optionA       String
  optionB       String
  optionC       String
  optionD       String
  optionE       String
  correctAnswer String  // "A" | "B" | "C" | "D" | "E"
  explanation   String? @db.Text

  // Metadata
  difficulty    Int     @default(3) // 1 (easy) → 5 (very hard)
  year          Int?    // denormalized for fast filtering by year without join
  topic         String? // fine-grained topic e.g. "Cell Biology", "Acids & Bases"
  source        String? // e.g. "IMAT 2024 Official"
  isActive      Boolean @default(true) // allows soft-deleting bad questions

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  paper    Paper     @relation(fields: [paperId], references: [id])
  attempts Attempt[]

  @@index([section])
  @@index([paperId])
  @@index([difficulty])
  @@index([topic])
  @@map("questions")
}

// ─────────────────────────────────────────
// ATTEMPT  (one row per question answered)
// ─────────────────────────────────────────

model Attempt {
  id             String   @id @default(cuid())
  userId         String
  questionId     String
  selectedAnswer String   // "A" | "B" | "C" | "D" | "E"
  isCorrect      Boolean
  timeTaken      Int      // seconds spent on this question
  sessionId      String?  // optional: link to a full exam session

  createdAt      DateTime @default(now())

  // Relations
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  session  Session? @relation(fields: [sessionId], references: [id])

  @@index([userId])
  @@index([questionId])
  @@index([userId, createdAt])
  @@map("attempts")
}

// ─────────────────────────────────────────
// SESSION  (one row per full quiz/exam run)
// ─────────────────────────────────────────

model Session {
  id             String   @id @default(cuid())
  userId         String
  paperId        String?  // null = custom practice session, not paper-based
  mode           QuizMode @default(PRACTICE)
  sectionFilter  String?  // optional section filter e.g. "BIOLOGY", "CHEMISTRY"
  score          Float    // percentage 0–100 or IMAT score
  totalQuestions Int
  correctCount   Int      @default(0)
  timeTaken      Int      // seconds for entire session
  completed      Boolean  @default(false)

  createdAt      DateTime @default(now())

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  paper    Paper?    @relation(fields: [paperId], references: [id])
  attempts Attempt[]

  @@index([userId])
  @@index([userId, createdAt])
  @@map("sessions")
}
